<section
  class="nit nit-spec nit-section"
  aria-labelledby="nit-spec-heading"
>
  <div class="nit-container nit-spec__inner">
    <div class="nit-spec__head"><p class="nit-label nit-reveal">Specification</p><h2 class="nit-h2 nit-spec__heading nit-reveal" id="nit-spec-heading">
        The numbers
      </h2>
    </div><table class="nit-spec__table nit-nums">
      <caption class="nit-visually-hidden">The numbers</caption>
      <tbody><tr class="nit-spec__row nit-spec__row--highlight" >
            <th class="nit-spec__key nit-label" scope="row">Suction</th><td class="nit-spec__value">
                <span class="nit-spec__whole">18,500</span><span class="nit-spec__frac" aria-hidden="true"></span>
              </td>
              <td class="nit-spec__unit">Pa</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Motor</th><td class="nit-spec__value nit-spec__value--text" colspan="2">Brushless, 110,000 rpm</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Filtration</th><td class="nit-spec__value nit-spec__value--text" colspan="2">HEPA, 0.3 &#181;m</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Runtime</th><td class="nit-spec__value">
                <span class="nit-spec__whole">32</span><span class="nit-spec__frac" aria-hidden="true"></span>
              </td>
              <td class="nit-spec__unit">minutes</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Charge time</th><td class="nit-spec__value">
                <span class="nit-spec__whole">2</span><span class="nit-spec__frac" aria-hidden="false">.5</span>
              </td>
              <td class="nit-spec__unit">hours</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Battery</th><td class="nit-spec__value">
                <span class="nit-spec__whole">2,500</span><span class="nit-spec__frac" aria-hidden="true"></span>
              </td>
              <td class="nit-spec__unit">mAh</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Capacity</th><td class="nit-spec__value">
                <span class="nit-spec__whole">0</span><span class="nit-spec__frac" aria-hidden="false">.5</span>
              </td>
              <td class="nit-spec__unit">L</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Noise</th><td class="nit-spec__value">
                <span class="nit-spec__whole">72</span><span class="nit-spec__frac" aria-hidden="true"></span>
              </td>
              <td class="nit-spec__unit">dB</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Weight</th><td class="nit-spec__value">
                <span class="nit-spec__whole">0</span><span class="nit-spec__frac" aria-hidden="false">.68</span>
              </td>
              <td class="nit-spec__unit">kg</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Nozzle</th><td class="nit-spec__value">
                <span class="nit-spec__whole">19</span><span class="nit-spec__frac" aria-hidden="true"></span>
              </td>
              <td class="nit-spec__unit">mm</td></tr><tr class="nit-spec__row" >
            <th class="nit-spec__key nit-label" scope="row">Dimensions</th><td class="nit-spec__value">
                <span class="nit-spec__whole">310</span><span class="nit-spec__frac" aria-hidden="true"></span>
              </td>
              <td class="nit-spec__unit">&#215; 78 &#215; 90 mm</td></tr></tbody>
    </table><p class="nit-small nit-muted nit-spec__footnote">Measured at sea level with an empty canister and a fully charged battery.</p></div>
</section>

{% schema %}
{
  "name": "Nitidus specification",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Nitidus specification"
    }
  ]
}
{% endschema %}
