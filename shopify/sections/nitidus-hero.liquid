<section class="nit nit-hero" data-nit-hero>
  <div class="nit-hero__light" aria-hidden="true"></div>

  <div class="nit-container nit-hero__inner">
    <div class="nit-hero__copy"><p class="nit-label nit-hero__eyebrow">Cordless car vacuum</p><h1 class="nit-display nit-hero__heading"><span class="nit-hero__line" style="--nit-line: 0">Considered</span><span class="nit-hero__line" style="--nit-line: 1">car care</span></h1>
    </div>

    <div class="nit-hero__stage">
  <div class="nit-gallery" data-nit-gallery data-nit-gallery-label="Views of the Nitidus cordless car vacuum">
    <ul class="nit-gallery__track">
    <li class="nit-gallery__slide"><div class="nit-media" style="--nit-ratio: 4/5"><div
      class="nit-360"
      data-nit-360
      data-nit-360-frames="36"
      data-nit-360-src=""
      data-nit-360-poster="{{ 'nitidus-product.webp' | asset_url }}"
      data-nit-360-pad="2"
      data-nit-360-slot="hero-360"
      data-nit-360-shot="Turntable, 36 frames at 10&#176;, cut out on transparency, lit from above left"
      data-nit-360-dims="1600 &#215; 2000 &middot; 4:5"
      data-nit-360-label="Nitidus cordless car vacuum, shown from every angle"
    ></div></div></li>
    <li class="nit-gallery__slide"><div class="nit-media" style="--nit-ratio: 4/5"><img class="nit-media__img" src="{{ 'nitidus-kit.webp' | asset_url }}" alt="The vacuum with all seven attachments and the charging cable" width="900" height="1125" loading="lazy" decoding="async"></div></li>
    <li class="nit-gallery__slide"><div class="nit-media" style="--nit-ratio: 4/5"><img class="nit-media__img" src="{{ 'nitidus-hand.webp' | asset_url }}" alt="The vacuum held in one hand, showing its size" width="900" height="1125" loading="lazy" decoding="async"></div></li>
    <li class="nit-gallery__slide"><div class="nit-media" style="--nit-ratio: 4/5"><img class="nit-media__img" src="{{ 'nitidus-car.webp' | asset_url }}" alt="The vacuum standing in a car cup holder beside the centre console" width="900" height="1125" loading="lazy" decoding="async"></div></li>
    </ul>
  </div>
</div>

    <div class="nit-hero__actions"><a class="nit-btn nit-btn--primary" href="">Buy &#8212; &#163;79</a><a class="nit-link nit-link--standalone" href="">See the specification</a></div>
  </div><div class="nit-hero__scroll" aria-hidden="true">
      <span class="nit-label">Scroll</span>
      <span class="nit-hero__scroll-line"></span>
    </div></section>

{% schema %}
{
  "name": "Nitidus hero",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Nitidus hero"
    }
  ]
}
{% endschema %}
