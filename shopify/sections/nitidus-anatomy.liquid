<section
  class="nit nit-anatomy"
  id="anatomy"
  aria-labelledby="nit-anatomy-heading"
  data-nit-anatomy
  style="--nit-steps: 4"
>
  <div class="nit-container nit-anatomy__intro"><p class="nit-label nit-reveal">Anatomy</p><h2 class="nit-h1 nit-anatomy__heading nit-reveal" id="nit-anatomy-heading">
      Four decisions that do the work
    </h2>
  </div>

  <div class="nit-anatomy__scroller">
    <div class="nit-anatomy__stage">
      <div class="nit-container nit-anatomy__layout">
        <div class="nit-anatomy__figure"><div class="nit-media" style="--nit-ratio: 4/5"><div class="nit-media__placeholder">
      <p class="nit-label nit-media__slot">anatomy-product</p>
      <p class="nit-media__shot nit-small">Product square on, cut out on transparency, even lighting so annotations read against it</p>
      <p class="nit-label nit-media__dims nit-nums">1600 &#215; 2000 &middot; 4:5</p>
    </div></div>
<ul
            class="nit-anatomy__spots"
            role="list"
            data-nit-anatomy-spots
            tabindex="0"
            aria-label="Product anatomy, swipe to move through each part"
          ><li
                class="nit-anatomy__spot"
                style="--x: 62%; --y: 30%"
                data-nit-anatomy-spot="0"
                data-side="end"
                
              >
                <span class="nit-anatomy__dot" aria-hidden="true"></span>
                <span class="nit-anatomy__leader" aria-hidden="true"></span>

                <span class="nit-anatomy__callout">
                  <span class="nit-label nit-anatomy__key">Motor</span>
                  <span class="nit-anatomy__value nit-nums">18,500 Pa</span><span class="nit-small nit-anatomy__note">Brushless, 110,000 rpm</span></span>
              </li><li
                class="nit-anatomy__spot"
                style="--x: 40%; --y: 47%"
                data-nit-anatomy-spot="1"
                data-side="start"
                
              >
                <span class="nit-anatomy__dot" aria-hidden="true"></span>
                <span class="nit-anatomy__leader" aria-hidden="true"></span>

                <span class="nit-anatomy__callout">
                  <span class="nit-label nit-anatomy__key">Filtration</span>
                  <span class="nit-anatomy__value nit-nums">HEPA, 0.3 &#181;m</span><span class="nit-small nit-anatomy__note">Washable, no cartridges to buy</span></span>
              </li><li
                class="nit-anatomy__spot"
                style="--x: 58%; --y: 66%"
                data-nit-anatomy-spot="2"
                data-side="end"
                
              >
                <span class="nit-anatomy__dot" aria-hidden="true"></span>
                <span class="nit-anatomy__leader" aria-hidden="true"></span>

                <span class="nit-anatomy__callout">
                  <span class="nit-label nit-anatomy__key">Battery</span>
                  <span class="nit-anatomy__value nit-nums">32 minutes</span><span class="nit-small nit-anatomy__note">USB-C, full charge in 2.5 hours</span></span>
              </li><li
                class="nit-anatomy__spot"
                style="--x: 36%; --y: 84%"
                data-nit-anatomy-spot="3"
                data-side="start"
                
              >
                <span class="nit-anatomy__dot" aria-hidden="true"></span>
                <span class="nit-anatomy__leader" aria-hidden="true"></span>

                <span class="nit-anatomy__callout">
                  <span class="nit-label nit-anatomy__key">Nozzle</span>
                  <span class="nit-anatomy__value nit-nums">19 mm</span><span class="nit-small nit-anatomy__note">Reaches the seat rail channel</span></span>
              </li></ul>
        </div><ol class="nit-anatomy__rail" aria-hidden="true"><li class="nit-anatomy__rail-step" data-nit-anatomy-rail="0">
              <span class="nit-anatomy__rail-mark"></span>
              <span class="nit-label">Motor</span>
            </li><li class="nit-anatomy__rail-step" data-nit-anatomy-rail="1">
              <span class="nit-anatomy__rail-mark"></span>
              <span class="nit-label">Filtration</span>
            </li><li class="nit-anatomy__rail-step" data-nit-anatomy-rail="2">
              <span class="nit-anatomy__rail-mark"></span>
              <span class="nit-label">Battery</span>
            </li><li class="nit-anatomy__rail-step" data-nit-anatomy-rail="3">
              <span class="nit-anatomy__rail-mark"></span>
              <span class="nit-label">Nozzle</span>
            </li></ol>
      </div>
    </div><div
        class="nit-anatomy__sentinel"
        data-nit-anatomy-sentinel="0"
        style="--i: 0"
        aria-hidden="true"
      ></div><div
        class="nit-anatomy__sentinel"
        data-nit-anatomy-sentinel="1"
        style="--i: 1"
        aria-hidden="true"
      ></div><div
        class="nit-anatomy__sentinel"
        data-nit-anatomy-sentinel="2"
        style="--i: 2"
        aria-hidden="true"
      ></div><div
        class="nit-anatomy__sentinel"
        data-nit-anatomy-sentinel="3"
        style="--i: 3"
        aria-hidden="true"
      ></div></div>
</section>

{% schema %}
{
  "name": "Nitidus anatomy",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Nitidus anatomy"
    }
  ]
}
{% endschema %}
