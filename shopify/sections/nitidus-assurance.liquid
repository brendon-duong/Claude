<section
  class="nit nit-assurance nit-assurance--marquee"
  aria-labelledby="nit-assurance-heading"
  data-nit-marquee
>
  <h2 class="nit-visually-hidden" id="nit-assurance-heading">
    Delivery, returns and support
  </h2>

  <div class="nit-assurance__viewport">
    <ul class="nit-assurance__track" role="list" data-nit-marquee-track><li class="nit-assurance__item" >
          <span class="nit-assurance__icon"><svg
  class="nit-icon nit-icon--parcel"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="butt"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
><path d="M12 4.75 4.75 8.5v7L12 19.25l7.25-3.75v-7z"/>
      <path d="M4.75 8.5 12 12.25l7.25-3.75M12 12.25v7"/></svg>
</span>
          <span class="nit-assurance__text">
            <span class="nit-label">Dispatch</span>
            <span class="nit-assurance__value nit-nums">Same day before 2pm</span>
          </span>
        </li><li class="nit-assurance__item" >
          <span class="nit-assurance__icon"><svg
  class="nit-icon nit-icon--return"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="butt"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
><path d="M8.75 5.75 5.25 9.25l3.5 3.5"/>
      <path d="M5.25 9.25h9.25a4.5 4.5 0 0 1 0 9H9.75"/></svg>
</span>
          <span class="nit-assurance__text">
            <span class="nit-label">Returns</span>
            <span class="nit-assurance__value nit-nums">30 days</span>
          </span>
        </li><li class="nit-assurance__item" >
          <span class="nit-assurance__icon"><svg
  class="nit-icon nit-icon--calendar"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="butt"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
><path d="M4.25 6.75h15.5v13H4.25z"/>
      <path d="M4.25 10.75h15.5M8.75 4.5v4M15.25 4.5v4"/></svg>
</span>
          <span class="nit-assurance__text">
            <span class="nit-label">Warranty</span>
            <span class="nit-assurance__value nit-nums">2 years</span>
          </span>
        </li><li class="nit-assurance__item" >
