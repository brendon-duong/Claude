            </span>
          </li><li class="nit-assurance__item">
            <span class="nit-assurance__icon"><svg
  class="nit-icon nit-icon--support"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="butt"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
