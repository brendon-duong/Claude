  class="nit-icon nit-icon--support"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="butt"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
><path d="M4.25 5.75h15.5v10.5h-7.75l-4.25 3.25V16.25H4.25z"/></svg>
</span>
          <span class="nit-assurance__text">
            <span class="nit-label">Support</span>
            <span class="nit-assurance__value nit-nums">UK, 1 working day</span>
          </span>
        </li></ul><ul class="nit-assurance__track" role="list" aria-hidden="true" data-nit-marquee-track><li class="nit-assurance__item">
            <span class="nit-assurance__icon"><svg
