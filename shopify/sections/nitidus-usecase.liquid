<section class="nit nit-usecase nit-section" aria-labelledby="nit-usecase-heading">
  <div class="nit-container nit-usecase__inner">
    <div class="nit-usecase__head"><p class="nit-label nit-reveal">In use</p><h2 class="nit-h1 nit-usecase__heading nit-reveal" id="nit-usecase-heading">
        Where it actually gets used
      </h2>
    </div>

    <ul class="nit-usecase__grid" role="list" data-nit-stagger><li
          class="nit-usecase__item nit-reveal"
          style="--nit-ratio: 4/5"
          
        >
          <figure class="nit-usecase__figure">
            <div
              class="nit-usecase__stage"
              data-nit-video-slot
              data-nit-video-trigger="view"
              data-pause-label="Pause this clip"
              data-play-label="Play this clip"
            ><div class="nit-media" style="--nit-ratio: 4/5"><img class="nit-media__img" src="{{ 'nitidus-use-footwell.webp' | asset_url }}" alt="The flat crevice tool, the attachment for lifting dry mud along a door sill" width="1200" height="1500" loading="lazy" decoding="async"></div>
</div>

            <figcaption class="nit-usecase__caption">
              <span class="nit-label">Footwell</span>
              <span class="nit-small nit-usecase__note">Dry mud along the sill, lifted in one pass</span>
            </figcaption>
          </figure>
        </li><li
          class="nit-usecase__item nit-reveal"
          style="--nit-ratio: 1/1"
          
        >
          <figure class="nit-usecase__figure">
            <div
              class="nit-usecase__stage"
              data-nit-video-slot
              data-nit-video-trigger="view"
              data-pause-label="Pause this clip"
              data-play-label="Play this clip"
            ><div class="nit-media" style="--nit-ratio: 1/1"><img class="nit-media__img" src="{{ 'nitidus-use-childseat.webp' | asset_url }}" alt="The cone nozzle, the attachment for crumbs in a child seat's buckle recess and seams" width="900" height="900" loading="lazy" decoding="async"></div>
</div>

            <figcaption class="nit-usecase__caption">
              <span class="nit-label">Child seat</span>
              <span class="nit-small nit-usecase__note">Crumbs out of the buckle recess and seam</span>
            </figcaption>
          </figure>
        </li><li
          class="nit-usecase__item nit-reveal"
          style="--nit-ratio: 16/9"
          
        >
          <figure class="nit-usecase__figure">
            <div
              class="nit-usecase__stage"
              data-nit-video-slot
              data-nit-video-trigger="view"
              data-pause-label="Pause this clip"
              data-play-label="Play this clip"
            ><div class="nit-media" style="--nit-ratio: 16/9"><img class="nit-media__img" src="{{ 'nitidus-use-boot.webp' | asset_url }}" alt="The wide brush head, the attachment for sand and grit across a boot floor" width="1024" height="576" loading="lazy" decoding="async"></div>
</div>

            <figcaption class="nit-usecase__caption">
              <span class="nit-label">Boot</span>
              <span class="nit-small nit-usecase__note">Sand and grit across the full boot floor</span>
            </figcaption>
          </figure>
        </li><li
          class="nit-usecase__item nit-reveal"
          style="--nit-ratio: 3/4"
          
        >
          <figure class="nit-usecase__figure">
            <div
              class="nit-usecase__stage"
              data-nit-video-slot
              data-nit-video-trigger="view"
              data-pause-label="Pause this clip"
              data-play-label="Play this clip"
            ><div class="nit-media" style="--nit-ratio: 3/4"><img class="nit-media__img" src="{{ 'nitidus-use-seatrails.webp' | asset_url }}" alt="The extended narrow nozzle, the attachment for the seat rail channel" width="1200" height="1600" loading="lazy" decoding="async"></div>
</div>

            <figcaption class="nit-usecase__caption">
              <span class="nit-label">Seat rails</span>
              <span class="nit-small nit-usecase__note">The channel a full-size head cannot reach</span>
            </figcaption>
          </figure>
        </li></ul>
  </div>
</section>

{% schema %}
{
  "name": "Nitidus use cases",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Nitidus use cases"
    }
  ]
}
{% endschema %}
