<section class="nit nit-usecase nit-section" aria-labelledby="nit-usecase-heading">
  <div class="nit-container nit-usecase__inner">
    <div class="nit-usecase__head"><p class="nit-label nit-reveal">In use</p><h2 class="nit-h1 nit-usecase__heading nit-reveal" id="nit-usecase-heading">
        Where it actually gets used
      </h2>
    </div>

    <ul class="nit-usecase__grid" role="list" data-nit-stagger><li
          class="nit-usecase__item nit-reveal"
          style="--nit-ratio: 4/5"
          
        >
          <figure class="nit-usecase__figure">
            <div
              class="nit-usecase__stage"
              data-nit-video-slot
              data-nit-video-trigger="view"
              data-pause-label="Pause this clip"
              data-play-label="Play this clip"
            ><div class="nit-media" style="--nit-ratio: 4/5"><div class="nit-media__placeholder">
      <p class="nit-label nit-media__slot">use-footwell</p>
      <p class="nit-media__shot nit-small">Footwell, low angle, nozzle entering the sill channel</p>
      <p class="nit-label nit-media__dims nit-nums">1200 &#215; 1500 &middot; 4:5</p>
    </div></div>
</div>

            <figcaption class="nit-usecase__caption">
              <span class="nit-label">Footwell</span>
              <span class="nit-small nit-usecase__note">Dry mud along the sill, lifted in one pass</span>
            </figcaption>
          </figure>
        </li><li
          class="nit-usecase__item nit-reveal"
          style="--nit-ratio: 1/1"
          
        >
          <figure class="nit-usecase__figure">
            <div
              class="nit-usecase__stage"
              data-nit-video-slot
              data-nit-video-trigger="view"
              data-pause-label="Pause this clip"
              data-play-label="Play this clip"
            ><div class="nit-media" style="--nit-ratio: 1/1"><div class="nit-media__placeholder">
      <p class="nit-label nit-media__slot">use-child-seat</p>
      <p class="nit-media__shot nit-small">Child seat, crevice tool in the buckle recess</p>
      <p class="nit-label nit-media__dims nit-nums">1400 &#215; 1400 &middot; 1:1</p>
    </div></div>
</div>

            <figcaption class="nit-usecase__caption">
              <span class="nit-label">Child seat</span>
              <span class="nit-small nit-usecase__note">Crumbs out of the buckle recess and seam</span>
            </figcaption>
          </figure>
        </li><li
          class="nit-usecase__item nit-reveal"
          style="--nit-ratio: 16/9"
          
        >
          <figure class="nit-usecase__figure">
            <div
              class="nit-usecase__stage"
              data-nit-video-slot
              data-nit-video-trigger="view"
              data-pause-label="Pause this clip"
              data-play-label="Play this clip"
            ><div class="nit-media" style="--nit-ratio: 16/9"><div class="nit-media__placeholder">
      <p class="nit-label nit-media__slot">use-boot</p>
      <p class="nit-media__shot nit-small">Open boot, wide, brush head across the load floor</p>
      <p class="nit-label nit-media__dims nit-nums">1920 &#215; 1080 &middot; 16:9</p>
    </div></div>
</div>

            <figcaption class="nit-usecase__caption">
              <span class="nit-label">Boot</span>
              <span class="nit-small nit-usecase__note">Sand and grit across the full boot floor</span>
            </figcaption>
          </figure>
        </li><li
          class="nit-usecase__item nit-reveal"
          style="--nit-ratio: 3/4"
          
        >
          <figure class="nit-usecase__figure">
            <div
              class="nit-usecase__stage"
              data-nit-video-slot
              data-nit-video-trigger="view"
              data-pause-label="Pause this clip"
              data-play-label="Play this clip"
            ><div class="nit-media" style="--nit-ratio: 3/4"><div class="nit-media__placeholder">
      <p class="nit-label nit-media__slot">use-seat-rails</p>
      <p class="nit-media__shot nit-small">Seat rail channel, tight, nozzle running along the track</p>
      <p class="nit-label nit-media__dims nit-nums">1200 &#215; 1600 &middot; 3:4</p>
    </div></div>
</div>

            <figcaption class="nit-usecase__caption">
              <span class="nit-label">Seat rails</span>
              <span class="nit-small nit-usecase__note">The channel a full-size head cannot reach</span>
            </figcaption>
          </figure>
        </li></ul>
  </div>
</section>

{% schema %}
{
  "name": "Nitidus use cases",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Nitidus use cases"
    }
  ]
}
{% endschema %}
